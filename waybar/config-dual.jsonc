[
    {
        "output": "eDP-1",
        "layer": "top",
        "position": "top",
        "margin-top": 13,
        "modules-left": ["hyprland/workspaces#internal", "custom/mic", "custom/camera"],
        "modules-center": ["clock"],
        "modules-right": ["hyprland/language", "bluetooth", "network", "pulseaudio", "backlight", "battery"],

        "hyprland/workspaces#internal": {
            "format": "{icon}",
            "on-click": "activate",
            "format-icons": {
                "urgent": "󰀨",
                "active": "",
                "default": ""
            },
            "sort-by-number": true,
            "all-outputs": false,
            "persistent-workspaces": {
                "eDP-1": [1, 2, 3]
            },
            "show-special": false
        },

        "custom/mic": {
            "format": "{}",
            "return-type": "json",
            "exec": "~/.config/waybar/scripts/mic_status.sh",
            "interval": 1, // Check every 1 second
            "tooltip": false, // Optional: Set to true if you want a tooltip (e.g., "Microphone in use")
            "on-click": "pactl set-source-mute @DEFAULT_SOURCE@ toggle", // Optional: Toggle mic mute on click
            "on-click-right": "pavucontrol", // Optional: Open PulseAudio Volume Control on right-click
            "class": "custom-mic"
        },

        "custom/camera": {
            "interval": 2,
            "exec": "~/.config/waybar/scripts/camera_status.sh",
            "return-type": "json",
            "tooltip": false,
            "class": "custom-camera"
        },

        "keyboard-state":{
            "capslock": true,
            "format": "{icon}",
            "format-icons":{
                "locked": " A",
                "unlocked": ""
            },
            "device-path": "/dev/input/event4"
            // "device-path": "/dev/input/by-path/platform-i8042-serio-0-event-kbd"
            // Execute this command to identify device name: ls -l /dev/input/by-path/ | grep -i kbd
            // Use sudo evtest /dev/input/eventX to test the correct keyboard
        },

        "clock": {
            "tooltip-format": "<tt><small>{calendar}</small></tt>",
            "calendar": {
                "mode": "month",
                "mode-mon-col": 3,
                "weeks-pos": "right",
                "on-scroll": 1,
                "on-click-right": "mode",
                "format": {
                    "months": "<span color='#bb9af7'><b>{}</b></span>",  // Purple
                    "days": "<span color='#7aa2f7'><b>{}</b></span>",    // Blue
                    "weeks": "<span color='#9ece6a'><b>W{}</b></span>",  // Green
                    "weekdays": "<span color='#e0af68'><b>{}</b></span>",// Yellow
                    "today": "<span background='#2ac3de' color='#1a1b26'><b><u>{}</u></b></span>" // Cyan background with dark text
                }
            },
            "actions": {
                "on-click-right": "mode",
                "on-click-forward": "tz_up",
                "on-click-backward": "tz_down",
                "on-scroll-up": "shift_up",
                "on-scroll-down": "shift_down"
            },
            "format": "󰥔  {:%I:%M %p}",
            "format-alt": "󰥔  {:%a, %d  %b  %I:%M %p}",
            "interval": 1
        },

        "hyprland/language": {
            "format": "{}  ",
            "on-click": "hyprctl switchxkblayout at-translated-set-2-keyboard next",
            "format-es": "ESP",
            "format-en": "ENG"
        },

        "bluetooth": {
            "format-on": "",
            "format-connected": "",
            "format-disabled": "<span foreground='#5C6370'></span>",
            "tooltip-format": "{status}",
            "tooltip-format-connected": "{device_alias}",
            "on-click": "blueman-manager"
        },

        "network": {
            "format": "{icon} ",
            "format-wifi": "{icon} ",
            "format-ethernet": "󰈀",
            "format-disconnected": "󰤭",
            "tooltip-format": " {bandwidthUpBits}  {bandwidthDownBits}",
            "tooltip-format-wifi": "󰤨   {essid} ({signalStrength}%)",
            "tooltip-format-ethernet": "󰈀  {ifname} ({ipaddr}/{cidr})",
            "max-length": 50,
            "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
            "on-click": "nm-connection-editor"
        },

        "custom/pacman": {
            "format": " {}  ",
            "interval": "once",
            "exec": "checkupdates | wc -l",
            "on-click": "update-system",
            "signal": 8,
            "class": "custom-pacman"
        },

        "pulseaudio": {
            "format": "{icon} {volume}%",
            "format-bluetooth": "󰂱 {volume}%",
            "format-muted": "󰖁",
            "scroll-step": 1,
            "on-click": "pavucontrol",
            "ignored-sinks": ["Easy Effects Sink"],
            "format-icons": {
                "headphone": "  ",
                "hands-free": " ",
                "headset": "󰋎 ",
                "phone": " ",
                "portable": " ",
                "car": "",
                "default": ["󰖀", "󰕾"]
            }
        },

        "backlight": {
            "device": "intel_backlight",
            "format": "{icon} {percent}%",
            "format-icons": ["", "", "", "", "", "", "", "", ""]
        },

        "battery": {
            "format": "{icon} {capacity}%",
            "format-charging": "󰂄 {capacity}%",
            "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
        }
    },
    {
        "output": "HDMI-A-1",
        "layer": "top",
        "position": "top",
        "margin-top": 13,
        "modules-left": ["hyprland/workspaces#external", "custom/mic", "custom/camera"],
